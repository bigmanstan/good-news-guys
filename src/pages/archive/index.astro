---
import Layout from '../../layouts/Layout.astro';
import { digests, formatDate, splitDigest } from '../../lib/data';

// Group by month, newest first.
const months = new Map<string, typeof digests>();
for (const d of digests) {
  const key = d.date.slice(0, 7);
  if (!months.has(key)) months.set(key, []);
  months.get(key)!.push(d);
}
const monthLabel = (key: string) =>
  new Intl.DateTimeFormat('en-CA', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${key}-15T12:00:00Z`));
---

<Layout title="Archive" description="Every past daily digest of good news.">
  <section class="container page-head">
    <p class="eyebrow">Archive</p>
    <h1>Every day so far</h1>
    <p>{digests.length} {digests.length === 1 ? 'digest' : 'digests'}. Each one is kept exactly as it was published.</p>
  </section>

  <section class="container section first">
    {digests.length === 0 && <div class="empty">The archive starts with the first digest.</div>}
    {[...months].map(([key, list]) => (
      <div class="month">
        <h2>{monthLabel(key)}</h2>
        <ol>
          {list.map((d) => {
            const { top } = splitDigest(d);
            return (
              <li>
                <a href={`/archive/${d.date}`}>
                  <span class="date">{formatDate(d.date, true)}</span>
                  <span class="lead">{top[0]?.headline ?? 'No stories'}</span>
                  <span class="n">{d.stories.length} stories</span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </section>
</Layout>

<style>
  .first { margin-top: 28px; }
  .month + .month { margin-top: 40px; }
  .month h2 { font-size: 22px; margin-bottom: 12px; }
  ol { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  li a {
    display: grid; grid-template-columns: 120px 1fr auto; gap: 16px; align-items: baseline;
    padding: 14px 4px; border-bottom: 1px solid var(--line); text-decoration: none;
  }
  li a:hover .lead { text-decoration: underline; }
  .date { font-weight: 600; }
  .lead { font-family: var(--serif); font-size: 18px; min-width: 0; }
  .n { color: var(--muted); font-size: 14px; white-space: nowrap; }
  @media (max-width: 600px) {
    li a { grid-template-columns: 1fr auto; }
    .lead { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
