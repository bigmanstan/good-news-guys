---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="container page-head">
    <p class="eyebrow">404</p>
    <h1>This page took the day off</h1>
    <p>The story may be older than our archive, or the link has a typo. The good news: today’s digest is one click away.</p>
    <p class="go"><a class="btn btn-primary" href="/">Go to today’s good news</a></p>
  </section>
</Layout>

<style>
  .go { margin-top: 24px; }
</style>
