---
import Layout from '../layouts/Layout.astro';
import DigestView from '../components/DigestView.astro';
import { latest } from '../lib/data';
---

<Layout>
  {latest ? (
    <DigestView digest={latest} isLatest />
  ) : (
    <section class="container page-head">
      <h1>Good news is on its way</h1>
      <p>The first digest arrives at 6 AM Toronto time.</p>
    </section>
  )}
</Layout>
