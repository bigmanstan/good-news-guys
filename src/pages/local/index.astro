---
import Layout from '../../layouts/Layout.astro';
import CityPicker from '../../components/CityPicker.astro';
import { cities, recentStories } from '../../lib/data';

const counts = Object.fromEntries(
  cities.map((c) => [c.slug, recentStories((s) => s.region === c.slug).reduce((n, g) => n + g.stories.length, 0)]),
);
---

<Layout title="Local good news" description="Good news from your city, without tracking where you are.">
  <section class="container page-head">
    <p class="eyebrow">Local</p>
    <h1>Good news near you</h1>
    <p>Choose your city. Numbers show stories from the past week.</p>
  </section>
  <section class="container section first">
    <CityPicker counts={counts} />
  </section>
</Layout>

<style>
  .first { margin-top: 28px; }
</style>
