---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { sourceCount } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const {
  title,
  description = 'A short daily digest of genuinely good news from around the world and your city. No doomscrolling, no tracking.',
  image,
} = Astro.props;
const fullTitle = title ? `${title} · Good News Guys` : 'Good News Guys: today’s good news';
const path = Astro.url.pathname;
const active = (prefix: string) => (prefix === '/' ? path === '/' : path.startsWith(prefix)) ? 'page' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? 'Good News Guys'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#fbf8f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141310" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Apply the saved theme before first paint so there's no flash.
      try {
        const t = localStorage.getItem('gng:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Good News Guys home">
          <svg class="sun" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="7" />
            <g stroke-width="2.4" stroke-linecap="round">
              <path d="M16 2.5v3.5M16 26v3.5M2.5 16H6M26 16h3.5M6.4 6.4l2.5 2.5M23.1 23.1l2.5 2.5M6.4 25.6l2.5-2.5M23.1 8.9l2.5-2.5" />
            </g>
          </svg>
          <span>Good News Guys</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/" aria-current={active('/')}>Today</a>
          <a href="/local" data-local-link aria-current={active('/local')}>Local</a>
          <a href="/archive" aria-current={active('/archive')}>Archive</a>
          <a href="/bookmarks" aria-current={active('/bookmarks')}>Saved</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <p><strong>Good News Guys</strong> picks positive stories from {sourceCount} news sources every morning at 6 AM Toronto time, using plain rules. A person checks anything uncertain.</p>
        <p class="muted">No accounts, no ads, no tracking. Your saved stories and city stay in this browser only.</p>
      </div>
    </footer>

    <script>
      // Point the "Local" link straight at the reader's saved city.
      try {
        const city = localStorage.getItem('gng:city');
        const link = document.querySelector<HTMLAnchorElement>('[data-local-link]');
        if (city && link && /^[a-z0-9-]+$/.test(city)) link.href = `/local/${city}`;
      } catch {}
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--surface); padding: 8px 12px; border-radius: 8px; z-index: 10; }
  .skip:focus { left: 8px; }

  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 16px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 19px/1 var(--serif); white-space: nowrap; }
  .sun { width: 28px; height: 28px; fill: var(--accent); stroke: var(--accent); flex: none; }
  .nav { display: flex; gap: 4px; margin-left: auto; }
  .nav a {
    text-decoration: none; font: 600 15px/1 var(--sans); color: var(--muted);
    padding: 9px 12px; border-radius: 999px;
  }
  .nav a:hover { color: var(--ink); background: var(--surface-2); }
  .nav a[aria-current='page'] { color: var(--ink); background: var(--accent-soft); }

  @media (max-width: 640px) {
    .bar { height: auto; padding-top: 12px; padding-bottom: 8px; flex-wrap: wrap; row-gap: 6px; }
    .nav { order: 3; width: 100%; margin-left: -12px; overflow-x: auto; }
    .brand { margin-right: auto; }
  }

  .site-footer { margin-top: 80px; border-top: 1px solid var(--line); padding: 32px 0 48px; font-size: 15px; }
  .foot { display: grid; gap: 8px; max-width: 72ch; margin-left: 0; }
  @media (min-width: 1120px) { .foot { margin-left: auto; } }
  .muted { color: var(--muted); }
</style>
