---
import { CATEGORIES } from '../lib/data';

interface Props {
  current?: string;
  counts?: Record<string, number>;
}
const { current, counts } = Astro.props;
---

<nav class="cats" aria-label="Categories">
  {CATEGORIES.map((c) => (
    <a
      href={`/category/${c.slug}`}
      aria-current={c.slug === current ? 'page' : undefined}
      style={`--cat: var(--cat-${c.slug})`}
    >
      {c.label}
      {counts?.[c.slug] ? <span class="n">{counts[c.slug]}</span> : null}
    </a>
  ))}
</nav>

<style>
  .cats { display: flex; flex-wrap: wrap; gap: 8px; }
  a {
    display: inline-flex; align-items: center; gap: 6px;
    font: 600 14px/1 var(--sans); text-decoration: none;
    padding: 9px 14px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
  }
  a::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--cat); }
  a:hover { border-color: var(--cat); }
  a[aria-current='page'] { background: color-mix(in srgb, var(--cat) 14%, var(--surface)); border-color: var(--cat); }
  .n { color: var(--muted); font-weight: 500; }
</style>
