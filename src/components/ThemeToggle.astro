<button class="theme" type="button" data-theme-toggle aria-label="Theme: match system">
  <svg viewBox="0 0 24 24" aria-hidden="true" class="i-system"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="i-light"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="i-dark"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
</button>

<script>
  const ORDER = ['system', 'light', 'dark'] as const;
  type Mode = (typeof ORDER)[number];
  const LABEL: Record<Mode, string> = { system: 'Theme: match system', light: 'Theme: light', dark: 'Theme: dark' };

  function current(): Mode {
    try {
      const t = localStorage.getItem('gng:theme');
      return t === 'light' || t === 'dark' ? t : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') delete root.dataset.theme;
    else root.dataset.theme = mode;
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      btn.dataset.mode = mode;
      btn.setAttribute('aria-label', LABEL[mode]);
      btn.title = LABEL[mode];
    }
  }

  apply(current());
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-theme-toggle]')) return;
    const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
    try {
      if (next === 'system') localStorage.removeItem('gng:theme');
      else localStorage.setItem('gng:theme', next);
    } catch {}
    apply(next);
  });
</script>

<style>
  .theme {
    flex: none; width: 40px; height: 40px; border-radius: 999px;
    display: grid; place-items: center;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .theme:hover { border-color: var(--muted); }
  svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; display: none; }
  .theme:not([data-mode]) .i-system, .theme[data-mode='system'] .i-system,
  .theme[data-mode='light'] .i-light, .theme[data-mode='dark'] .i-dark { display: block; }
</style>
